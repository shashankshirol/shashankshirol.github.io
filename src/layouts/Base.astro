---
import '../styles/global.css';
import { profile } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
  showHomeLink?: boolean;
}

const {
  title,
  description = profile.summary,
  showHomeLink = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const inWriting = path.startsWith('/writing');
const GA_ID = 'G-BPPDJWYGCX';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f3f5f8" />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (() => {
        const system = matchMedia('(prefers-color-scheme: dark)');
        const saved = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };
        const apply = (theme) => {
          document.documentElement.dataset.theme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', theme === 'dark' ? '#101830' : '#f3f5f8');
          const button = document.querySelector('.theme-toggle');
          if (button) {
            button.hidden = false;
            button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          }
        };
        const current = () => saved() ?? (system.matches ? 'dark' : 'light');

        apply(current());
        // Follow the system setting until the visitor picks a theme themselves.
        system.addEventListener('change', () => apply(current()));
        document.addEventListener('DOMContentLoaded', () => {
          apply(current());
          document.querySelector('.theme-toggle')?.addEventListener('click', () => {
            const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem('theme', next);
            } catch {}
            apply(next);
          });
        });
      })();
    </script>
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      {showHomeLink ? <a class="home" href="/">{profile.name}</a> : <span />}
      <nav aria-label="Site">
        <ul>
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>About</a></li>
          <li><a href="/writing/" aria-current={inWriting ? 'page' : undefined}>Writing</a></li>
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
          <li>
            <button class="theme-toggle" type="button" aria-label="Switch to dark mode" hidden>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"></path>
              </svg>
            </button>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <span>&copy; {new Date().getFullYear()} {profile.name}</span>
      <a href="/rss.xml">RSS feed</a>
    </footer>
  </body>
</html>
