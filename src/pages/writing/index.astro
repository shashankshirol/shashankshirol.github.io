---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../data/posts';

const posts = await getPosts();
---

<Base title="Writing" description="Notes and essays by Shashank Shirol.">
  <h1>Writing</h1>
  {
    posts.length === 0 ? (
      <p class="empty">
        Nothing published yet. Subscribe to the <a href="/rss.xml">RSS feed</a> to get the first post when it is out.
      </p>
    ) : (
      <ol class="posts">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h2>
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
                {post.data.draft && <span class="draft">Draft</span>}
              </h2>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</Base>

<style>
  h1 {
    font-size: clamp(3.5rem, 12vw, 8rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
    padding-block: clamp(1rem, 4vw, 3rem) clamp(2rem, 6vw, 4rem);
  }

  .empty {
    max-width: 34rem;
    font-size: var(--step-1);
    padding-top: 2.75rem;
    border-top: 1px solid var(--rule);
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .posts li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 40rem);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
  }

  time {
    font-family: var(--display);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    padding-top: 0.5rem;
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: 0.375rem;
  }

  h2 a {
    color: var(--text);
  }

  .draft {
    margin-left: 0.75rem;
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    border-radius: 1em;
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    vertical-align: middle;
  }

  @media (max-width: 40rem) {
    .posts li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
