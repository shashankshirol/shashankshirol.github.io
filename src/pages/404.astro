---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <h1>This page does not exist.</h1>
  <p>The address may be mistyped, or the page may have moved. <a href="/">Go to the home page</a>.</p>
</Base>

<style>
  h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    padding-block: clamp(2rem, 8vw, 6rem) 1.5rem;
    max-width: 14ch;
  }
</style>
